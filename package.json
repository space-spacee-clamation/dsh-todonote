{
  "name": "dsh-todonote",
  "version": "0.1.0",
  "private": true,
  "description": "TodoNote — 碎屑工作计划便签：监控台 + 会话浮球 + 一键送进工作区会话，AI 只做手动触发的补充（背景/边界/影响面/成本/预期效果），不执行任何工作。",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/space-spacee-clamation/dsh-todonote.git"
  },
  "homepage": "https://github.com/space-spacee-clamation/dsh-todonote",
  "bugs": {
    "url": "https://github.com/space-spacee-clamation/dsh-todonote/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "tools",
    "tests",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "license": "MIT"
}
